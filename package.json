{
  "name": "recall-local",
  "productName": "Recall",
  "version": "0.6.0-beta.3",
  "private": true,
  "description": "A local study desk for concepts, mathematics and code",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "build": "vite build",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package-mac.cjs",
    "postpackage": "node scripts/apply-fuses.cjs && node scripts/audit-package.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "format": "prettier --write src electron/*.cjs tests scripts docs README.md",
    "test:desktop": "node scripts/smoke-public.cjs",
    "audit:release": "node scripts/audit-release.cjs",
    "audit:package": "node scripts/audit-package.cjs",
    "test:journey": "node --test tests/journey.test.cjs",
    "test:links": "node scripts/smoke-card-links.cjs",
    "test:live-imports": "node scripts/smoke-live-imports.cjs",
    "test:progress": "node scripts/smoke-progress.cjs",
    "test:connections": "node scripts/smoke-connections.cjs",
    "test:knowledge": "node scripts/smoke-knowledge-setup.cjs",
    "test:knowledge-bootstrap": "node scripts/smoke-knowledge-bootstrap.cjs",
    "test:security:native": "node scripts/security-native.cjs",
    "test:security:desktop": "node scripts/security-desktop.cjs",
    "test:voice": "node scripts/smoke-voice.cjs",
    "test:speak": "node scripts/smoke-speak.cjs",
    "build:pad-helper": "node scripts/build-pad-helper.cjs",
    "build:ipad": "node scripts/build-ipad.cjs",
    "release:mac": "node scripts/distribute-mac.cjs",
    "release:mac:check": "node scripts/distribute-mac.cjs --check",
    "release:ipad": "node scripts/archive-ipad.cjs",
    "release:ipad:check": "node scripts/archive-ipad.cjs --check",
    "test:handwriting": "node scripts/smoke-handwriting.cjs",
    "test:tutor-workspace": "node scripts/smoke-tutor-workspace.cjs",
    "test:paper-learning": "node scripts/smoke-paper-learning.cjs",
    "test:pad-lifecycle": "node scripts/smoke-pad-lifecycle.cjs",
    "docs:check": "node scripts/check-docs.cjs",
    "docs:screenshots": "node scripts/capture-docs.cjs"
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.17.1",
    "dompurify": "^3.4.14",
    "katex": "^0.18.6",
    "lucide-react": "^1.41.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "0.2.2",
    "ts-fsrs": "^5.4.2",
    "ws": "^8.22.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    },
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  },
  "bin": {
    "recall": "cli/recall.cjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
