{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "LearningCapture",
  "type": "object",
  "required": [
    "id",
    "sessionId",
    "title",
    "objective",
    "context",
    "at",
    "evidence",
    "cardIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "enum": ["discussed", "explained", "solved"]
    },
    "cardIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
