{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ContentPack",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "cards"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "Card"
      }
    }
  },
  "additionalProperties": true
}
